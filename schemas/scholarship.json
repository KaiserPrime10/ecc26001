{
  "formId": "scholarship",
  "title": {
    "en": "Scholarship Application",
    "hi": "छात्रवृत्ति आवेदन",
    "as": "স্কলারশ্বিপ আবেদন"
  },
  "fields": [
    {
      "id": "name",
      "type": "text",
      "required": true,
      "label": {
        "en": "Full name",
        "hi": "पूरा नाम",
        "as": "পূর্ণ নাম"
      }
    },
    {
      "id": "phone",
      "type": "phone",
      "required": true,
      "label": {
        "en": "Phone number",
        "hi": "फ़ोन नंबर",
        "as": "ফোন নম্বৰ"
      },
      "rules": {
        "pattern": "^[6-9]\\d{9}$"
      }
    },
    {
      "id": "dob",
      "type": "date",
      "required": true,
      "label": {
        "en": "Date of birth",
        "hi": "जन्म तिथि",
        "as": "জন্ম তারিখ"
      },
      "rules": {
        "minAge": 16,
        "maxAge": 40
      }
    },
    {
      "id": "income",
      "type": "number",
      "required": true,
      "label": {
        "en": "Annual family income",
        "hi": "वार्षिक पारिवारिक आय",
        "as": "বাৎসরিক পৰিয়ালিক আয়"
      },
      "rules": {
        "min": 0,
        "max": 10000000
      }
    },
    {
      "id": "district",
      "type": "select",
      "required": true,
      "label": {
        "en": "District",
        "hi": "ज़िला",
        "as": "জিলা"
      },
      "options": [
        "Kamrup Metropolitan",
        "Barpeta",
        "Jorhat"
      ]
    }
  ]
}
